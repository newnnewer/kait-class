# KAIT-PLAY 설정 — install.sh 가 처음 한 번 /opt/kait-play/.env 로 복사한다.
# 고친 뒤에는 KAIT-PLAY 만 다시 설치(sudo bash play/install.sh)하거나
#   cd /opt/kait-play && docker compose up -d
# 로 다시 띄운다. (진행 중인 게임은 사라지므로 수업 중에는 하지 않기)
#
# 주소는 언제나 KAIT-CLASS 주소 뒤의 /play/ 입니다 (바꿀 수 없음).

# 게임 서버 포트 (이 서버 안 127.0.0.1 에서만 쓰임. 다른 프로그램과 겹칠 때만 바꿈)
GAME_PORT=3100

# 동시에 들어올 수 있는 최대 인원 (여러 반이 동시에 쓰면 600 등으로)
MAX_PLAYERS=300

# 교사 화면(/play/teacher) 처음 비밀번호
#   비워 두면 install.sh 가 무작위로 만들어 보여 줘요.
#   교사 화면에서 바꾸면 그때부터 이 값은 쓰이지 않아요.
#   $ 기호는 쓰지 마세요 (Docker 설정에서 다른 뜻이 돼요).
ADMIN_PASSWORD=

# 체험(데모) 서버로 쓸 때만 1
#   교사 화면의 '비밀번호 바꾸기'를 막고, 화면 구석에 '체험 서버' 표시를 보여 줘요.
#   (KAIT-CLASS 의 config.php 'demo' => true 와 짝. 보통 학교 서버는 비워 둠)
DEMO=
